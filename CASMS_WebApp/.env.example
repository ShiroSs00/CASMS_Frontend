# Public URL only. Vite proxies /api to localhost:8080 during development.
# Production needs a same-origin /api proxy or the deployed backend URL here.
VITE_API_BASE_URL=/api
# Development-only backend origin. Never exposed in the browser bundle.
CASMS_API_PROXY_TARGET=http://127.0.0.1:8080
# Open-Meteo public geocoding is for non-commercial use. Set a licensed endpoint for commercial deployments.
VITE_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
# VITE_* values are exposed in the browser. Never put JWTs or secrets here.
