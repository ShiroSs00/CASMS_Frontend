{
  "expo": {
    "name": "OceVie Cruises",
    "slug": "CASMS_MobileApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ocevie/ios-app-icon-1024.png",
    "scheme": "casmsmobileapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/ocevie/ios-app-icon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061A2B",
        "foregroundImage": "./assets/ocevie/android-adaptive-foreground-432.png",
        "backgroundImage": "./assets/ocevie/android-adaptive-background-432.png",
        "monochromeImage": "./assets/ocevie/android-monochrome-432.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/ocevie/favicon-64.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061A2B",
          "image": "./assets/ocevie/ios-app-icon-1024.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
