# Copy to .env.qa.local. Use approved QA values only. Leave blank until confirmed.
# Set both URL values to the same team-approved API endpoint.
CASMS_MOBILE_QA_API_URL=
CASMS_MOBILE_QA_CONFIRMED_URL=
CASMS_MOBILE_QA_PASSENGER_USERNAME=
CASMS_MOBILE_QA_PASSENGER_PASSWORD=
CASMS_MOBILE_QA_STAFF_USERNAME=
CASMS_MOBILE_QA_STAFF_PASSWORD=
# PostgreSQL service defined locally by the QA team with a read-only account.
CASMS_MOBILE_QA_PG_SERVICE=
CASMS_MOBILE_QA_DATABASE=
