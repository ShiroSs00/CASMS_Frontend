# Copy to .env.local, then select the address reachable from the app.
# Windows Web preview or iOS Simulator (Backend on the same computer):
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8080/api
# Android Emulator (Backend on the development computer):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
# Physical Android/iOS devices: use the Backend computer's LAN IP and port.
# Release/QA builds: use the HTTPS URL supplied for that environment.
# EXPO_PUBLIC_* values are bundled in the app. Use a URL only.
EXPO_PUBLIC_API_URL=
